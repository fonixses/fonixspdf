NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. Defaults to ./temp and must be writable by the Node.js process.
FONIXS_TEMP_DIR="/absolute/path/to/fonixspdf-temp"

# Optional. Defaults to ./vendor/pdfbox-app-3.0.8.jar after npm run setup:pdfbox.
PDFBOX_JAR_PATH="/absolute/path/to/pdfbox-app-3.0.8.jar"

# Optional. Defaults to ./vendor/qpdf-12.4.0/bin/qpdf, then the system qpdf.
QPDF_BINARY_PATH="/absolute/path/to/qpdf"

# Bundled Tesseract.js languages. Supported values: eng, ind, eng+ind.
FONIXS_OCR_LANG="eng+ind"
